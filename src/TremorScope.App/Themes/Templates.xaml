<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:c="clr-namespace:TremorScope.App.Controls"
                    xmlns:vm="clr-namespace:TremorScope.App.ViewModels">

    <c:BoolToVisibility x:Key="Visible" />
    <c:QualityToBrush x:Key="QualityBrush" />
    <c:ConditionToBrush x:Key="ConditionBrush" />
    <c:Scale x:Key="Scale" />
    <c:ShareToStar x:Key="ShareToStar" />
    <c:StepState x:Key="StepState" />

    <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <!-- 品質の表示（色つきの小さな札） -->
    <DataTemplate x:Key="QualityChip" DataType="{x:Type vm:ConditionCard}">
        <Border Style="{StaticResource Chip}" Background="{Binding Quality, Converter={StaticResource QualityBrush}, ConverterParameter=Soft}">
            <StackPanel Orientation="Horizontal">
                <Ellipse Width="7" Height="7" Fill="{Binding Quality, Converter={StaticResource QualityBrush}}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock Text="{Binding QualityText}" FontFamily="{StaticResource UiFont}" FontSize="12" FontWeight="SemiBold"
                           Foreground="{Binding Quality, Converter={StaticResource QualityBrush}}" />
            </StackPanel>
        </Border>
    </DataTemplate>

    <!-- 1 つの条件の結果カード（結果画面・測定中の確認で使う） -->
    <DataTemplate x:Key="ConditionCardTemplate" DataType="{x:Type vm:ConditionCard}">
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border Background="{Binding IsRest, Converter={StaticResource ConditionBrush}}" CornerRadius="10,10,0,0" />
                <StackPanel Grid.Row="1" Margin="22,18,22,20">
                    <DockPanel>
                        <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource QualityChip}" />
                        <TextBlock Text="{Binding Title}" FontFamily="{StaticResource UiFont}" FontSize="19" FontWeight="Bold"
                                   Foreground="{Binding IsRest, Converter={StaticResource ConditionBrush}}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Subtitle}" Style="{StaticResource Muted}" Margin="0,2,0,14" />

                    <UniformGrid Columns="2" Rows="2">
                        <StackPanel Margin="0,0,12,14">
                            <TextBlock Text="ピーク周波数" Style="{StaticResource MetricLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Peak}" Style="{StaticResource BigNumber}" />
                                <TextBlock Text="Hz" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="ふるえの大きさ（RMS）" Style="{StaticResource MetricLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Rms}" Style="{StaticResource BigNumber}" />
                                <TextBlock Text="mg" Style="{StaticResource Unit}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Margin="0,0,12,0">
                            <TextBlock Text="推定変位（RMS・目安）" Style="{StaticResource MetricLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Displacement}" Style="{StaticResource BigNumber}" FontSize="26" />
                                <TextBlock Text="mm" Style="{StaticResource Unit}" Margin="4,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Text="規則性" Style="{StaticResource MetricLabel}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Regularity}" Style="{StaticResource BigNumber}" FontSize="26" />
                                <TextBlock Text="%" Style="{StaticResource Unit}" Margin="4,0,0,3" />
                            </StackPanel>
                        </StackPanel>
                    </UniformGrid>

                    <TextBlock Text="周波数帯ごとの割合" Style="{StaticResource MetricLabel}" Margin="0,18,0,8" />
                    <ItemsControl ItemsSource="{Binding Bands}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:BandBar}">
                                <StackPanel Margin="3,0">
                                    <TextBlock Text="{Binding Percent}" FontFamily="{StaticResource NumberFont}" FontSize="12" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Ink2Brush}" Margin="0,0,0,3" />
                                    <Border Height="56" Background="{StaticResource SunkenBrush}" CornerRadius="4">
                                        <Border x:Name="Bar" VerticalAlignment="Bottom" CornerRadius="4" Background="{StaticResource Ink3Brush}" Opacity="0.55"
                                                Height="{Binding Share, Converter={StaticResource Scale}, ConverterParameter=56}" />
                                    </Border>
                                    <TextBlock Text="{Binding Label}" FontFamily="{StaticResource NumberFont}" FontSize="11.5" HorizontalAlignment="Center"
                                               Foreground="{StaticResource Ink3Brush}" Margin="0,4,0,0" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsLargest}" Value="True">
                                        <Setter TargetName="Bar" Property="Background"
                                                Value="{Binding DataContext.IsRest, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource ConditionBrush}}" />
                                        <Setter TargetName="Bar" Property="Opacity" Value="1" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Style="{StaticResource Well}" Margin="0,16,0,0" Background="{Binding Quality, Converter={StaticResource QualityBrush}, ConverterParameter=Soft}"
                            Visibility="{Binding HasQualityMessages, Converter={StaticResource Visible}}">
                        <ItemsControl ItemsSource="{Binding QualityMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Foreground="{StaticResource InkBrush}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>
    </DataTemplate>
</ResourceDictionary>
