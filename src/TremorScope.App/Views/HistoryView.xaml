<UserControl x:Class="TremorScope.App.Views.HistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TremorScope.App.ViewModels"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <Grid Margin="36,32,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="270" />
            <RowDefinition Height="20" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                <CheckBox Content="カルテ番号を含める" IsChecked="{Binding IncludeLocalId}" Margin="0,0,12,0" VerticalAlignment="Center" />
                <Button Content="一覧を CSV で保存" Command="{Binding ExportCsvCommand}" Margin="0,0,8,0" />
                <Button Content="新しく測定する" Style="{StaticResource PrimaryButton}" Command="{Binding MeasureCommand}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}">
                    <Run Text="HISTORY · " /><Run Text="{Binding Patient.PseudonymId, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Style="{StaticResource PageTitle}">
                    <Run Text="{Binding Patient.LocalId, Mode=OneWay}" FontFamily="{StaticResource NumberFont}" /><Run Text=" の経過" />
                </TextBlock>
                <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="0,4,0,0" Visibility="{Binding Message, Converter={StaticResource Visible}}" />
            </StackPanel>
        </DockPanel>

        <!-- 経過のグラフ -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="20,16,20,8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ふるえの大きさの推移（RMS）" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                <Grid>
                    <sp:WpfPlot x:Name="TrendPlot" />
                    <TextBlock Text="測定するとここに推移が表示されます" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                </Grid>
            </DockPanel>
        </Border>

        <!-- 測定の一覧 -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Padding="18">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="17,0,17,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.4*" />
                        <ColumnDefinition Width="0.6*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.1*" />
                        <ColumnDefinition Width="1.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="日時" Style="{StaticResource MetricLabel}" />
                    <TextBlock Grid.Column="1" Text="手" Style="{StaticResource MetricLabel}" />
                    <TextBlock Grid.Column="2" Text="安静時 mg / Hz" Style="{StaticResource MetricLabel}" Foreground="{StaticResource RestBrush}" />
                    <TextBlock Grid.Column="3" Text="姿勢時 mg / Hz" Style="{StaticResource MetricLabel}" Foreground="{StaticResource PosturalBrush}" />
                    <TextBlock Grid.Column="4" Text="比較" Style="{StaticResource MetricLabel}" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,6" />
                <Grid>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Sessions}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:SessionRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1.4*" />
                                        <ColumnDefinition Width="0.6*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.1*" />
                                        <ColumnDefinition Width="1.8*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding When}" FontFamily="{StaticResource NumberFont}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding Note, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding Hand}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" FontFamily="{StaticResource NumberFont}" FontSize="15" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center">
                                        <Run Text="{Binding RestRms, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  /  " Foreground="{StaticResource Ink3Brush}" /><Run Text="{Binding RestPeak, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="3" FontFamily="{StaticResource NumberFont}" FontSize="15" Foreground="{StaticResource InkBrush}" VerticalAlignment="Center">
                                        <Run Text="{Binding PosturalRms, Mode=OneWay}" FontWeight="SemiBold" /><Run Text="  /  " Foreground="{StaticResource Ink3Brush}" /><Run Text="{Binding PosturalPeak, Mode=OneWay}" />
                                    </TextBlock>
                                    <TextBlock Grid.Column="4" Text="{Binding Pattern}" Style="{StaticResource Body}" VerticalAlignment="Center" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Text="まだ測定がありません" Style="{StaticResource Muted}" HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}" />
                </Grid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
