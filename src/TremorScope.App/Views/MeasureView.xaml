<UserControl x:Class="TremorScope.App.Views.MeasureView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:TremorScope.App.Controls"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <UserControl.Resources>
        <!-- 上の段階表示: 済み / いま / これから -->
        <Style x:Key="StepDot" TargetType="Border">
            <Setter Property="Width" Value="26" />
            <Setter Property="Height" Value="26" />
            <Setter Property="CornerRadius" Value="13" />
            <Setter Property="Background" Value="{StaticResource SunkenBrush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Current">
                    <Setter Property="Background" Value="{StaticResource InkBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Done">
                    <Setter Property="Background" Value="{StaticResource RestBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource NumberFont}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Current">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Done">
                    <Setter Property="Foreground" Value="White" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="StepLabel" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Margin" Value="9,0,0,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{StaticResource Ink3Brush}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Current">
                    <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
                    <Setter Property="FontWeight" Value="Bold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Done">
                    <Setter Property="Foreground" Value="{StaticResource Ink2Brush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="36,32,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- 見出しと段階 -->
        <DockPanel Margin="0,0,0,22">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,4">
                <Border Style="{StaticResource StepDot}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=0}">
                    <TextBlock Text="1" Style="{StaticResource StepText}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=0}" />
                </Border>
                <TextBlock Text="安静時" Style="{StaticResource StepLabel}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=0}" />
                <Border Width="36" Height="1" Background="{StaticResource LineBrush}" Margin="14,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource StepDot}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=1}">
                    <TextBlock Text="2" Style="{StaticResource StepText}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=1}" />
                </Border>
                <TextBlock Text="姿勢時" Style="{StaticResource StepLabel}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=1}" />
                <Border Width="36" Height="1" Background="{StaticResource LineBrush}" Margin="14,0" VerticalAlignment="Center" />
                <Border Style="{StaticResource StepDot}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=2}">
                    <TextBlock Text="3" Style="{StaticResource StepText}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=2}" />
                </Border>
                <TextBlock Text="結果" Style="{StaticResource StepLabel}" Tag="{Binding StepIndex, Converter={StaticResource StepState}, ConverterParameter=2}" />
            </StackPanel>
            <StackPanel>
                <TextBlock Style="{StaticResource Eyebrow}">
                    <Run Text="MEASUREMENT · " /><Run Text="{Binding Patient.LocalId, Mode=OneWay}" />
                </TextBlock>
                <TextBlock Text="{Binding InstructionTitle}" Style="{StaticResource PageTitle}" />
            </StackPanel>
        </DockPanel>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="372" />
            </Grid.ColumnDefinitions>

            <!-- 左: 波形 -->
            <Border Style="{StaticResource Card}" Padding="20,18,20,12">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                        <Border Style="{StaticResource Chip}" DockPanel.Dock="Left" Background="{Binding IsRest, Converter={StaticResource ConditionBrush}, ConverterParameter=Soft}">
                            <TextBlock Text="{Binding ConditionLabel}" FontWeight="Bold" FontSize="13" Foreground="{Binding IsRest, Converter={StaticResource ConditionBrush}}" />
                        </Border>
                        <TextBlock Text="ふるえの成分（重力と姿勢のゆっくりした変化を除いた値）" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Ellipse Width="8" Height="8" Margin="0,0,7,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{StaticResource CautionBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SensorLive}" Value="True">
                                                <Setter Property="Fill" Value="{StaticResource GoodBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Text="{Binding SensorStatus}" Style="{StaticResource Muted}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxWidth="360" />
                        </StackPanel>
                    </DockPanel>
                    <sp:WpfPlot x:Name="LivePlot" />
                </DockPanel>
            </Border>

            <!-- 右: 計器と操作 -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <!-- 残り時間 -->
                    <Grid DockPanel.Dock="Top" Width="190" Height="190" Margin="0,4,0,18">
                        <c:ArcProgress Value="{Binding Progress}" Thickness="11" Track="{StaticResource SunkenBrush}"
                                       Stroke="{Binding IsRest, Converter={StaticResource ConditionBrush}}" />
                        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding Countdown}" FontFamily="{StaticResource NumberFont}" FontSize="58" FontWeight="SemiBold"
                                       Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"
                                       Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding DurationSeconds, StringFormat={}{0}}" FontFamily="{StaticResource NumberFont}" FontSize="58" FontWeight="SemiBold"
                                       Foreground="{StaticResource Ink3Brush}" HorizontalAlignment="Center"
                                       Visibility="{Binding IsPrepare, Converter={StaticResource Visible}}" />
                            <TextBlock Text="&#xE73E;" FontFamily="{StaticResource IconFont}" FontSize="44"
                                       Foreground="{Binding IsRest, Converter={StaticResource ConditionBrush}}" HorizontalAlignment="Center"
                                       Visibility="{Binding IsReview, Converter={StaticResource Visible}}" />
                            <TextBlock Text="{Binding CountdownCaption}" Style="{StaticResource Muted}" HorizontalAlignment="Center" TextAlignment="Center" MaxWidth="140"
                                       Visibility="{Binding IsRunning, Converter={StaticResource Visible}}" />
                            <TextBlock Text="秒 測定します" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                       Visibility="{Binding IsPrepare, Converter={StaticResource Visible}}" />
                            <TextBlock Text="記録しました" Style="{StaticResource Muted}" HorizontalAlignment="Center"
                                       Visibility="{Binding IsReview, Converter={StaticResource Visible}}" />
                        </StackPanel>
                    </Grid>

                    <TextBlock DockPanel.Dock="Bottom" Text="{Binding ErrorMessage}" Style="{StaticResource Muted}" Foreground="{StaticResource DangerBrush}" Margin="0,12,0,0"
                               Visibility="{Binding ErrorMessage, Converter={StaticResource Visible}}" />

                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid>
                        <!-- 準備 -->
                        <StackPanel Visibility="{Binding IsPrepare, Converter={StaticResource Visible}}">
                            <TextBlock Text="{Binding InstructionBody}" Style="{StaticResource Body}" />
                            <StackPanel Visibility="{Binding IsRest, Converter={StaticResource Visible}}" Margin="0,18,0,0">
                                <TextBlock Text="測定する手" Style="{StaticResource FieldLabel}" />
                                <Border Background="{StaticResource SunkenBrush}" CornerRadius="9" Padding="2" HorizontalAlignment="Left">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Style="{StaticResource Segment}" Content="右手" GroupName="Hand" IsChecked="{Binding IsRightHand}" />
                                        <RadioButton Style="{StaticResource Segment}" Content="左手" GroupName="Hand" IsChecked="{Binding IsLeftHand}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock Text="メモ（任意・この PC の中だけ）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                                <TextBox Text="{Binding Note, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                            </StackPanel>
                            <Button Style="{StaticResource BigPrimaryButton}" Command="{Binding BeginCommand}" HorizontalAlignment="Stretch" Margin="0,20,0,0">
                                <TextBlock>
                                    <Run Text="{Binding ConditionLabel, Mode=OneWay}" /><Run Text="の測定を開始" />
                                </TextBlock>
                            </Button>
                            <Button Content="安静時だけで終える" Style="{StaticResource GhostButton}" Command="{Binding FinishWithRestOnlyCommand}" HorizontalAlignment="Center" Margin="0,8,0,0"
                                    Visibility="{Binding IsRest, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
                            <Button Content="やめる" Style="{StaticResource GhostButton}" Command="{Binding CancelCommand}" HorizontalAlignment="Center" Margin="0,4,0,0" />
                        </StackPanel>

                        <!-- 測定中 -->
                        <StackPanel Visibility="{Binding IsRunning, Converter={StaticResource Visible}}">
                            <TextBlock Style="{StaticResource Body}" Text="そのままの姿勢を保ってもらってください。最初の数秒は、姿勢が落ち着くのを待つため記録に使いません。" />
                            <Button Content="中止する" Command="{Binding AbortCommand}" HorizontalAlignment="Stretch" Margin="0,20,0,0" />
                        </StackPanel>

                        <!-- 確認 -->
                        <DockPanel Visibility="{Binding IsReview, Converter={StaticResource Visible}}">
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
                                <Button Style="{StaticResource BigPrimaryButton}" Content="{Binding NextLabel}" Command="{Binding NextCommand}" HorizontalAlignment="Stretch" />
                                <Button Content="取り直す" Command="{Binding RetakeCommand}" HorizontalAlignment="Stretch" Margin="0,8,0,0" />
                            </StackPanel>
                            <StackPanel DataContext="{Binding ReviewCard}">
                                <DockPanel Margin="0,0,0,12">
                                    <ContentControl DockPanel.Dock="Right" Content="{Binding}" ContentTemplate="{StaticResource QualityChip}" />
                                    <TextBlock Text="{Binding Title}" Style="{StaticResource SectionTitle}" Margin="0" />
                                </DockPanel>
                                <UniformGrid Columns="2">
                                    <StackPanel Margin="0,0,8,10">
                                        <TextBlock Text="ピーク周波数" Style="{StaticResource MetricLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Peak}" Style="{StaticResource BigNumber}" FontSize="28" />
                                            <TextBlock Text="Hz" Style="{StaticResource Unit}" Margin="4,0,0,4" />
                                        </StackPanel>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="大きさ（RMS）" Style="{StaticResource MetricLabel}" />
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Rms}" Style="{StaticResource BigNumber}" FontSize="28" />
                                            <TextBlock Text="mg" Style="{StaticResource Unit}" Margin="4,0,0,4" />
                                        </StackPanel>
                                    </StackPanel>
                                </UniformGrid>
                                <ItemsControl ItemsSource="{Binding QualityMessages}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding}" Style="{StaticResource Muted}" Foreground="{StaticResource CautionBrush}" Margin="0,4,0,0" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DockPanel>

                        <!-- 保存中 -->
                        <TextBlock Text="保存しています…" Style="{StaticResource Body}" HorizontalAlignment="Center" Margin="0,20,0,0"
                                   Visibility="{Binding IsSaving, Converter={StaticResource Visible}}" />
                    </Grid>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
