<UserControl x:Class="TremorScope.App.Views.PatientsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TremorScope.App.ViewModels">
    <Grid Margin="36,32,36,28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="28" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,22">
            <TextBlock Text="PATIENTS" Style="{StaticResource Eyebrow}" />
            <TextBlock Text="患者を選ぶ" Style="{StaticResource PageTitle}" />
        </StackPanel>

        <!-- 一覧 -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="18">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <TextBox x:Name="SearchBox" Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Padding="36,9,10,9" />
                    <TextBlock Text="&#xE721;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Ink3Brush}"
                               VerticalAlignment="Center" Margin="13,0,0,0" IsHitTestVisible="False" />
                    <TextBlock Text="カルテ番号・仮名 ID・メモで探す" Foreground="{StaticResource Ink3Brush}" FontSize="14" VerticalAlignment="Center"
                               Margin="37,0,0,0" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=SearchBox, Converter={StaticResource Visible}, ConverterParameter=Invert}" />
                </Grid>

                <Grid DockPanel.Dock="Top" Margin="17,0,17,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="1.6*" />
                        <ColumnDefinition Width="0.8*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="カルテ番号" Style="{StaticResource MetricLabel}" />
                    <TextBlock Grid.Column="1" Text="仮名 ID（クラウド用）" Style="{StaticResource MetricLabel}" />
                    <TextBlock Grid.Column="2" Text="最終測定" Style="{StaticResource MetricLabel}" />
                    <TextBlock Grid.Column="3" Text="測定" Style="{StaticResource MetricLabel}" HorizontalAlignment="Right" />
                </Grid>
                <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,6" />

                <Grid>
                    <ListBox Style="{StaticResource PlainList}" ItemsSource="{Binding Patients}" SelectedItem="{Binding Selected}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:PatientRow}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="1.6*" />
                                        <ColumnDefinition Width="0.8*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{Binding LocalId}" FontFamily="{StaticResource NumberFont}" FontSize="17" FontWeight="SemiBold"
                                                   Foreground="{StaticResource InkBrush}" />
                                        <TextBlock Text="{Binding Note}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                                                   Visibility="{Binding Note, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="1" Text="{Binding PseudonymId}" FontFamily="{StaticResource NumberFont}" FontSize="13.5"
                                               Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="2" Text="{Binding LastMeasured}" FontFamily="{StaticResource NumberFont}" FontSize="13.5"
                                               Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="3" Text="{Binding Count}" FontFamily="{StaticResource NumberFont}" FontSize="13.5"
                                               Foreground="{StaticResource Ink2Brush}" VerticalAlignment="Center" HorizontalAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding IsEmpty, Converter={StaticResource Visible}}">
                        <TextBlock Text="&#xE716;" FontFamily="{StaticResource IconFont}" FontSize="34" Foreground="{StaticResource LineBrush}" HorizontalAlignment="Center" />
                        <TextBlock Text="患者が見つかりません" Style="{StaticResource SectionTitle}" HorizontalAlignment="Center" Margin="0,10,0,4" />
                        <TextBlock Text="右の欄でカルテ番号を登録すると、ここに表示されます。" Style="{StaticResource Muted}" HorizontalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <!-- 右: 登録と操作 -->
        <StackPanel Grid.Row="1" Grid.Column="2">
            <Border Style="{StaticResource Card}" Visibility="{Binding HasSelection, Converter={StaticResource Visible}}" Margin="0,0,0,18">
                <StackPanel>
                    <TextBlock Text="選択中" Style="{StaticResource Eyebrow}" />
                    <TextBlock Text="{Binding Selected.LocalId}" FontFamily="{StaticResource NumberFont}" FontSize="28" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
                    <TextBlock Style="{StaticResource Muted}" Margin="0,2,0,16">
                        <Run Text="仮名 ID " /><Run Text="{Binding Selected.PseudonymId, Mode=OneWay}" FontFamily="{StaticResource NumberFont}" />
                        <Run Text=" · " /><Run Text="{Binding Selected.Count, Mode=OneWay}" />
                    </TextBlock>
                    <Button Style="{StaticResource BigPrimaryButton}" Command="{Binding MeasureCommand}" HorizontalAlignment="Stretch">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D9;" FontFamily="{StaticResource IconFont}" FontSize="15" VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="測定を始める" />
                        </StackPanel>
                    </Button>
                    <UniformGrid Columns="2" Margin="0,10,0,0">
                        <Button Content="履歴と経過" Command="{Binding HistoryCommand}" Margin="0,0,5,0" />
                        <Button Content="削除…" Style="{StaticResource DangerButton}" Command="{Binding DeleteCommand}" Margin="5,0,0,0" />
                    </UniformGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="新しい患者を登録" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="カルテ番号" Style="{StaticResource FieldLabel}" />
                    <TextBox Text="{Binding NewLocalId, UpdateSourceTrigger=PropertyChanged}" FontFamily="{StaticResource NumberFont}" FontSize="16" MaxLength="64" />
                    <TextBlock Text="メモ（任意・この PC の中だけ）" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox Text="{Binding NewNote, UpdateSourceTrigger=PropertyChanged}" MaxLength="200" />
                    <Button Content="登録して選ぶ" Style="{StaticResource PrimaryButton}" Command="{Binding RegisterCommand}" Margin="0,16,0,0" IsDefault="True" />
                    <Border Style="{StaticResource Well}" Margin="0,18,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE72E;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource PrimaryBrush}" Margin="0,3,10,0" VerticalAlignment="Top" />
                            <TextBlock Style="{StaticResource Muted}" MaxWidth="270"
                                       Text="カルテ番号とメモは、この PC の中だけに保存します。クラウドに送るのは、カルテ番号から作った仮名 ID と測定値だけです。" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <TextBlock Text="{Binding Message}" Style="{StaticResource Muted}" Margin="4,14,0,0" Visibility="{Binding Message, Converter={StaticResource Visible}}" />
        </StackPanel>
    </Grid>
</UserControl>
