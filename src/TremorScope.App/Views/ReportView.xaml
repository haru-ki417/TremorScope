<UserControl x:Class="TremorScope.App.Views.ReportView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:TremorScope.App.ViewModels"
             Background="White" FontFamily="{StaticResource UiFont}" TextOptions.TextFormattingMode="Ideal" UseLayoutRounding="True">
    <!-- A4 横のレポート（1169 × 827。画像にするときは 1.5 倍の 1754 × 1240 ピクセル） -->
    <UserControl.Resources>
        <DataTemplate x:Key="ReportCondition" DataType="{x:Type vm:ConditionCard}">
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="0" Margin="0,0,0,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="{Binding IsRest, Converter={StaticResource ConditionBrush}}" CornerRadius="8,0,0,8" />
                    <StackPanel Grid.Column="1" Margin="16,12,16,12">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding QualityText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"
                                       Foreground="{Binding Quality, Converter={StaticResource QualityBrush}}" />
                            <TextBlock FontSize="17" FontWeight="Bold" Foreground="{Binding IsRest, Converter={StaticResource ConditionBrush}}">
                                <Run Text="{Binding Title, Mode=OneWay}" /><Run Text="  " /><Run Text="{Binding Duration, Mode=OneWay}" FontSize="12" FontWeight="Normal" Foreground="{StaticResource Ink3Brush}" />
                            </TextBlock>
                        </DockPanel>
                        <UniformGrid Columns="4" Margin="0,8,0,0">
                            <StackPanel>
                                <TextBlock Text="ピーク周波数" Style="{StaticResource MetricLabel}" FontSize="11" />
                                <TextBlock FontFamily="{StaticResource NumberFont}" Foreground="{StaticResource InkBrush}">
                                    <Run Text="{Binding Peak, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" /><Run Text=" Hz" FontSize="12" Foreground="{StaticResource Ink3Brush}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="大きさ（RMS）" Style="{StaticResource MetricLabel}" FontSize="11" />
                                <TextBlock FontFamily="{StaticResource NumberFont}" Foreground="{StaticResource InkBrush}">
                                    <Run Text="{Binding Rms, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" /><Run Text=" mg" FontSize="12" Foreground="{StaticResource Ink3Brush}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="推定変位（目安）" Style="{StaticResource MetricLabel}" FontSize="11" />
                                <TextBlock FontFamily="{StaticResource NumberFont}" Foreground="{StaticResource InkBrush}">
                                    <Run Text="{Binding Displacement, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" /><Run Text=" mm" FontSize="12" Foreground="{StaticResource Ink3Brush}" />
                                </TextBlock>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="規則性" Style="{StaticResource MetricLabel}" FontSize="11" />
                                <TextBlock FontFamily="{StaticResource NumberFont}" Foreground="{StaticResource InkBrush}">
                                    <Run Text="{Binding Regularity, Mode=OneWay}" FontSize="24" FontWeight="SemiBold" /><Run Text=" %" FontSize="12" Foreground="{StaticResource Ink3Brush}" />
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                        <ItemsControl ItemsSource="{Binding Bands}" Margin="0,8,0,0">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Rows="1" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:BandBar}">
                                    <TextBlock FontFamily="{StaticResource NumberFont}" FontSize="11" Foreground="{StaticResource Ink2Brush}">
                                        <Run Text="{Binding Label, Mode=OneWay}" /><Run Text=" " /><Run Text="{Binding Percent, Mode=OneWay}" FontWeight="SemiBold" />
                                    </TextBlock>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <ItemsControl ItemsSource="{Binding QualityMessages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" FontSize="11" Foreground="{StaticResource CautionBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="44,36,44,30">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 見出し -->
        <DockPanel>
            <StackPanel DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                <TextBlock Text="{Binding FacilityLine}" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" HorizontalAlignment="Right" />
                <TextBlock Text="TremorScope · 測定補助" FontFamily="{StaticResource NumberFont}" FontSize="12" Foreground="{StaticResource Ink3Brush}" HorizontalAlignment="Right" />
            </StackPanel>
            <StackPanel Orientation="Horizontal">
                <Border Width="34" Height="34" CornerRadius="9" Background="{StaticResource RailBrush}" VerticalAlignment="Center">
                    <Path Data="M3,17 L8,17 L10,10 L13,24 L16,6 L19,26 L22,12 L24,17 L31,17" Stroke="{StaticResource RestBrush}" StrokeThickness="2.2"
                          StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                </Border>
                <TextBlock Text="振戦測定レポート" FontSize="27" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="14,0,0,0" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>
        <Border Height="2" Background="{StaticResource InkBrush}" VerticalAlignment="Bottom" Margin="0,0,0,-12" />

        <!-- 患者と測定の情報 -->
        <Grid Grid.Row="1" Margin="0,26,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="{Binding PatientIdLabel}" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="{Binding PatientIdValue}" FontFamily="{StaticResource NumberFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1">
                <TextBlock Text="測定日時" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="{Binding MeasuredAt}" FontFamily="{StaticResource NumberFont}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="測定した手" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="{Binding Hand}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="3">
                <TextBlock Text="センサー" Style="{StaticResource MetricLabel}" />
                <TextBlock Text="3 軸加速度 · 手の甲" FontSize="16" Foreground="{StaticResource InkBrush}" Margin="0,3,0,0" />
            </StackPanel>
        </Grid>

        <!-- 比較 -->
        <Border Grid.Row="2" Background="{StaticResource PaperBrush}" CornerRadius="8" Padding="18,12" Margin="0,18,0,16">
            <StackPanel>
                <TextBlock Text="{Binding PatternTitle}" FontSize="19" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                <TextBlock Text="{Binding PatternSummary}" FontSize="14" Foreground="{StaticResource InkBrush}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 条件ごとの値とスペクトル -->
        <Grid Grid.Row="3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="540" />
                <ColumnDefinition Width="20" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <DockPanel>
                <ContentControl DockPanel.Dock="Top" Content="{Binding Rest}" ContentTemplate="{StaticResource ReportCondition}" />
                <ContentControl DockPanel.Dock="Top" Content="{Binding Postural}" ContentTemplate="{StaticResource ReportCondition}" />
                <!-- 医師が手で書き込む欄（印刷して使う） -->
                <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1" CornerRadius="8" Padding="16,10">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="所見・メモ（記入欄）" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                        <UniformGrid Rows="4">
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />
                            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" />
                        </UniformGrid>
                    </DockPanel>
                </Border>
            </DockPanel>
            <DockPanel Grid.Column="2">
                <TextBlock DockPanel.Dock="Top" Text="周波数の分布（スペクトル）　帯: 4〜6 Hz" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource Ink2Brush}" />
                <Image Source="{Binding SpectrumImage}" Stretch="Uniform" VerticalAlignment="Top" Margin="0,6,0,0" />
            </DockPanel>
        </Grid>

        <!-- 注意書き -->
        <StackPanel Grid.Row="4" Margin="0,10,0,0">
            <Border Height="1" Background="{StaticResource LineBrush}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Disclaimer}" FontSize="11.5" Foreground="{StaticResource Ink2Brush}" TextWrapping="Wrap" />
            <TextBlock Text="{Binding Footer}" FontFamily="{StaticResource NumberFont}" FontSize="10.5" Foreground="{StaticResource Ink3Brush}" Margin="0,4,0,0" />
        </StackPanel>
    </Grid>
</UserControl>
