<UserControl x:Class="TremorScope.App.Views.ResultView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="36,32,36,32">
            <!-- 見出しと操作 -->
            <DockPanel Margin="0,0,0,22">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Bottom">
                    <Button Command="{Binding PrintCommand}" Margin="0,0,8,0" ToolTip="A4 横で印刷します（カルテ番号入り）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE749;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="印刷" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding SaveImageCommand}" Margin="0,0,8,0" ToolTip="レポートを PNG 画像で保存します（カルテ番号入り）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xEB9F;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="画像で保存" />
                        </StackPanel>
                    </Button>
                    <Button Command="{Binding ExportWaveformCommand}" Margin="0,0,8,0" ToolTip="記録した 3 軸の波形を CSV で保存します（ファイル名は仮名 ID）">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9D2;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="波形 CSV" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendToPacsCommand}"
                            Visibility="{Binding PacsEnabled, Converter={StaticResource Visible}}" ToolTip="レポートを DICOM 画像にして PACS へ送ります">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE898;" FontFamily="{StaticResource IconFont}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="PACS へ送信" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <StackPanel>
                    <TextBlock Style="{StaticResource Eyebrow}">
                        <Run Text="RESULT · " /><Run Text="{Binding Session.LocalId, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Text="{Binding PatternTitle}" Style="{StaticResource PageTitle}" />
                    <TextBlock Text="{Binding Header}" Style="{StaticResource Muted}" Margin="0,4,0,0" />
                </StackPanel>
            </DockPanel>

            <TextBlock Text="{Binding Message}" Style="{StaticResource Body}" Foreground="{StaticResource PrimaryBrush}" Margin="0,0,0,14"
                       Visibility="{Binding Message, Converter={StaticResource Visible}}" />

            <!-- 比較 -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Visibility="{Binding IsLoaded, Converter={StaticResource Visible}}">
                <StackPanel>
                    <TextBlock Text="安静時と姿勢時の比較" Style="{StaticResource SectionTitle}" />
                    <TextBlock Text="{Binding PatternSummary}" Style="{StaticResource Body}" FontSize="15" />
                    <Grid Height="12" Margin="0,16,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{Binding RestShare, Converter={StaticResource ShareToStar}}" />
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="{Binding RestShare, Converter={StaticResource ShareToStar}, ConverterParameter=Rest}" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource RestBrush}" CornerRadius="6,0,0,6" />
                        <Border Grid.Column="2" Background="{StaticResource PosturalBrush}" CornerRadius="0,6,6,0" />
                    </Grid>
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" Foreground="{StaticResource PosturalBrush}">
                            <Run Text="姿勢時 " /><Run Text="{Binding Postural.Rms, Mode=OneWay}" FontFamily="{StaticResource NumberFont}" /><Run Text=" mg" />
                        </TextBlock>
                        <TextBlock Style="{StaticResource Muted}" Foreground="{StaticResource RestBrush}">
                            <Run Text="安静時 " /><Run Text="{Binding Rest.Rms, Mode=OneWay}" FontFamily="{StaticResource NumberFont}" /><Run Text=" mg" />
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
            </Border>

            <!-- 条件ごと -->
            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <ContentControl Content="{Binding Rest}" ContentTemplate="{StaticResource ConditionCardTemplate}" Focusable="False" />
                <ContentControl Grid.Column="2" Content="{Binding Postural}" ContentTemplate="{StaticResource ConditionCardTemplate}" Focusable="False" />
            </Grid>

            <!-- スペクトル -->
            <Border Style="{StaticResource Card}" Margin="0,0,0,20" Padding="22,18,22,10">
                <StackPanel>
                    <TextBlock Text="周波数の分布（スペクトル）" Style="{StaticResource SectionTitle}" Margin="0,0,0,2" />
                    <TextBlock Text="山の位置がふるえの周波数、高さが強さです。帯は 4〜6 Hz（安静時振戦でよくみられる範囲）。" Style="{StaticResource Muted}" />
                    <sp:WpfPlot x:Name="SpectrumPlot" Height="330" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Well}" Padding="18,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE946;" FontFamily="{StaticResource IconFont}" FontSize="14" Foreground="{StaticResource Ink2Brush}" Margin="0,3,10,0" VerticalAlignment="Top" />
                        <TextBlock Text="{Binding Disclaimer}" Style="{StaticResource Muted}" MaxWidth="900" />
                    </StackPanel>
                    <TextBlock Text="{Binding DeliveryStatus}" Style="{StaticResource Muted}" Margin="24,8,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                <Button Content="履歴へ戻る" Command="{Binding BackCommand}" Margin="0,0,10,0" />
                <Button Content="もう一度測定する" Command="{Binding MeasureAgainCommand}" Style="{StaticResource GhostButton}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
