@* 線のアイコン（外の部品を使わず、SVG で描く） *@
<svg class="icon @(Small ? "small" : "")" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @switch (Name)
    {
        case "measure": <rect x="3" y="4" width="18" height="16" rx="3" /><path d="M6 12h3l2-4 2 8 2-4h3" />; break;
        case "result": <path d="M5 20V10M10 20V4M15 20v-7M20 20v-4" />; break;
        case "history": <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5M12 7v5l3 2" />; break;
        case "about": <circle cx="12" cy="12" r="9" /><path d="M12 11v6M12 7.5v.01" />; break;
        case "print": <path d="M6 9V3h12v6M6 18H4a1 1 0 0 1-1-1v-6a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v6a1 1 0 0 1-1 1h-2" /><rect x="6" y="14" width="12" height="7" />; break;
        case "download": <path d="M12 4v11M7 10l5 5 5-5M5 20h14" />; break;
        case "trash": <path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3" />; break;
        case "play": <path d="M7 4l13 8-13 8z" />; break;
        case "stop": <rect x="6" y="6" width="12" height="12" rx="1" />; break;
        case "retry": <path d="M3 12a9 9 0 1 0 3-6.7L3 8" /><path d="M3 3v5h5" />; break;
        case "next": <path d="M5 12h14M13 6l6 6-6 6" />; break;
        case "phone": <rect x="7" y="2" width="10" height="20" rx="2" /><path d="M11 18h2" />; break;
        case "wave": <path d="M2 12h3l2-6 3 12 3-9 2 5 2-2h5" />; break;
        case "check": <path d="M5 12l5 5L20 7" />; break;
        case "warn": <path d="M12 4l9 16H3z" /><path d="M12 10v4M12 17v.01" />; break;
        case "x": <path d="M6 6l12 12M18 6L6 18" />; break;
        case "plus": <path d="M12 5v14M5 12h14" />; break;
        case "lock": <rect x="5" y="11" width="14" height="10" rx="2" /><path d="M8 11V7a4 4 0 0 1 8 0v4" />; break;
        case "github": <path d="M9 19c-4 1.3-4-2-6-2.5m12 4.5v-3.4a3 3 0 0 0-.8-2.3c2.7-.3 5.6-1.3 5.6-6a4.6 4.6 0 0 0-1.3-3.2 4.3 4.3 0 0 0-.1-3.2s-1-.3-3.4 1.3a11.6 11.6 0 0 0-6 0C6.6 2.6 5.6 2.9 5.6 2.9a4.3 4.3 0 0 0-.1 3.2A4.6 4.6 0 0 0 4.2 9.3c0 4.6 2.9 5.7 5.6 6a3 3 0 0 0-.8 2.3V21" />; break;
        case "windows": <path d="M3 5.5l7.5-1v7H3zM12 4.3L21 3v8.5h-9zM3 12.5h7.5v7L3 18.5zM12 12.5h9V21l-9-1.3z" />; break;
        default: <circle cx="12" cy="12" r="2" />; break;
    }
</svg>

@code {
    [Parameter, EditorRequired] public string Name { get; set; } = "";
    [Parameter] public bool Small { get; set; }
}
